{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codepreflight.dev/protocol/v1/schema.json",
  "title": "CodePreFlight engine protocol",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "command", "repositoryPath", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "command": { "enum": ["commit", "doctor", "hooks", "init", "pr_prepare", "providers", "review", "status"] },
        "repositoryPath": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "event"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string" },
        "event": { "enum": ["ready", "progress", "consent_required", "provider_delta", "finding", "complete", "error"] },
        "payload": { "type": "object" },
        "error": {
          "type": "object",
          "required": ["code", "message", "recoverable"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "recoverable": { "type": "boolean" },
            "details": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
