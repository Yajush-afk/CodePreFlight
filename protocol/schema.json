{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codepreflight.dev/protocol/v4/schema.json",
  "title": "CodePreFlight engine protocol",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/event" }],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "command",
        "repositoryPath",
        "payload"
      ],
      "properties": {
        "protocolVersion": { "const": 4 },
        "requestId": { "type": "string", "minLength": 1 },
        "command": {
          "enum": [
            "automation",
            "cache",
            "commit",
            "doctor",
            "explain",
            "findings",
            "git_action",
            "hooks",
            "init",
            "panel_review",
            "pr_prepare",
            "provider",
            "providers",
            "review",
            "scan",
            "status",
            "workspace"
          ]
        },
        "repositoryPath": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "event"],
      "properties": {
        "protocolVersion": { "const": 4 },
        "requestId": { "type": "string" },
        "event": {
          "enum": [
            "ready",
            "progress",
            "consent_required",
            "provider_delta",
            "finding",
            "job_update",
            "recovery_required",
            "scan_progress",
            "workflow_stage",
            "operation_started",
            "operation_completed",
            "operation_skipped",
            "readiness_changed",
            "complete",
            "error"
          ]
        },
        "payload": { "type": "object" },
        "error": {
          "type": "object",
          "required": ["code", "message", "recoverable"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "recoverable": { "type": "boolean" },
            "details": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "enum": ["critical", "high", "medium", "low"]
    },
    "findingLifecycle": {
      "enum": ["open", "needs_rereview", "resolved", "dismissed"]
    },
    "findingReconciliation": {
      "type": "object",
      "required": ["finding_id", "outcome", "explanation", "evidence"],
      "properties": {
        "finding_id": { "type": "string" },
        "outcome": { "enum": ["present", "resolved", "uncertain"] },
        "explanation": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceLocation" }
        }
      },
      "additionalProperties": false
    },
    "findingLedgerItem": {
      "type": "object",
      "required": [
        "id",
        "branch",
        "category",
        "path",
        "symbol",
        "title",
        "explanation",
        "impact",
        "recommendation",
        "severity",
        "legacy_severity",
        "confidence",
        "verification",
        "lifecycle",
        "first_seen_snapshot",
        "last_seen_snapshot",
        "last_evaluated_snapshot",
        "last_commit",
        "target",
        "provider_id",
        "provider_model",
        "dismissal_reason",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "branch": { "type": "string" },
        "category": { "type": "string" },
        "path": { "type": "string" },
        "symbol": { "type": "string" },
        "title": { "type": "string" },
        "explanation": { "type": "string" },
        "impact": { "type": "string" },
        "recommendation": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "legacy_severity": {
          "enum": ["warning", "suggestion", "informational", null]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "verification": { "$ref": "#/$defs/verificationState" },
        "lifecycle": { "$ref": "#/$defs/findingLifecycle" },
        "first_seen_snapshot": { "type": "string" },
        "last_seen_snapshot": { "type": "string" },
        "last_evaluated_snapshot": { "type": ["string", "null"] },
        "last_commit": { "type": "string" },
        "target": { "type": "string" },
        "provider_id": { "type": "string" },
        "provider_model": { "type": ["string", "null"] },
        "dismissal_reason": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findingOccurrence": {
      "type": "object",
      "required": [
        "review_id",
        "snapshot",
        "commit_oid",
        "target",
        "severity",
        "verification",
        "evidence",
        "observed_at"
      ],
      "properties": {
        "review_id": { "type": "string" },
        "snapshot": { "type": "string" },
        "commit_oid": { "type": "string" },
        "target": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "verification": { "$ref": "#/$defs/verificationState" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceLocation" }
        },
        "observed_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findingTransition": {
      "type": "object",
      "required": ["from_state", "to_state", "reason", "created_at"],
      "properties": {
        "from_state": { "$ref": "#/$defs/findingLifecycle" },
        "to_state": { "$ref": "#/$defs/findingLifecycle" },
        "reason": { "type": "string" },
        "review_id": { "type": ["string", "null"] },
        "commit_oid": { "type": ["string", "null"] },
        "created_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findingDetail": {
      "type": "object",
      "required": ["finding", "occurrences", "transitions"],
      "properties": {
        "finding": { "$ref": "#/$defs/findingLedgerItem" },
        "occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingOccurrence" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingTransition" }
        }
      },
      "additionalProperties": false
    },
    "verificationState": {
      "enum": ["verified", "partially_verified", "unverified", "rejected"]
    },
    "evidenceLocation": {
      "type": "object",
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "lifecycle",
        "category",
        "title",
        "explanation",
        "impact",
        "confidence",
        "verification",
        "verification_notes",
        "evidence",
        "recommendation",
        "suggested_tests"
      ],
      "properties": {
        "id": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "lifecycle": { "$ref": "#/$defs/findingLifecycle" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "explanation": { "type": "string" },
        "impact": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "verification": { "$ref": "#/$defs/verificationState" },
        "verification_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceLocation" }
        },
        "recommendation": { "type": "string" },
        "suggested_tests": { "type": "array", "items": { "type": "string" } },
        "legacy_severity": {
          "enum": ["warning", "suggestion", "informational", null]
        }
      },
      "additionalProperties": false
    },
    "gitRisk": {
      "enum": ["low", "medium", "high", "irreversible"]
    },
    "gitOperationPlan": {
      "type": "object",
      "required": [
        "id",
        "action",
        "commands",
        "fingerprint",
        "risk",
        "confirmation"
      ],
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" } },
        "fingerprint": { "type": "string" },
        "risk": { "$ref": "#/$defs/gitRisk" },
        "confirmation": { "enum": ["explicit", "typed"] },
        "head_oid": { "type": ["string", "null"] },
        "index_fingerprint": { "type": ["string", "null"] },
        "worktree_fingerprint": { "type": ["string", "null"] },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "selected_paths": { "type": "array", "items": { "type": "string" } },
        "selected_hunks": { "type": "array", "items": { "type": "string" } },
        "source": { "type": ["string", "null"] },
        "destination": { "type": ["string", "null"] },
        "expected_effects": { "type": "array", "items": { "type": "string" } },
        "expected_conflicts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hook_involvement": { "type": "boolean" },
        "editor_involvement": { "type": "boolean" },
        "credential_helper_involvement": { "type": "boolean" },
        "recovery_limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "gitOperationResult": {
      "type": "object",
      "required": ["plan_id", "action", "status", "message"],
      "properties": {
        "plan_id": { "type": "string" },
        "action": { "type": "string" },
        "status": {
          "enum": ["completed", "failed", "cancelled", "conflicted"]
        },
        "message": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "repository": { "$ref": "#/$defs/repositoryView" },
        "conflict": {
          "anyOf": [{ "$ref": "#/$defs/conflictState" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "conflictState": {
      "type": "object",
      "required": ["operation", "files", "can_continue", "can_abort"],
      "properties": {
        "operation": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "can_continue": { "type": "boolean" },
        "can_abort": { "type": "boolean" },
        "editor_available": { "type": "boolean" },
        "mergetool_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fileChange": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "staged",
        "unstaged",
        "untracked",
        "ignored"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "staged": { "type": "boolean" },
        "unstaged": { "type": "boolean" },
        "untracked": { "type": "boolean" },
        "ignored": { "type": "boolean" },
        "previous_path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "repositoryView": {
      "type": "object",
      "required": [
        "root",
        "branch",
        "base_branch",
        "upstream",
        "ahead",
        "behind",
        "files",
        "conflicts"
      ],
      "properties": {
        "root": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "base_branch": { "type": ["string", "null"] },
        "upstream": { "type": ["string", "null"] },
        "ahead": { "type": "integer" },
        "behind": { "type": "integer" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "workspaceView": {
      "type": "object",
      "required": ["repository", "findings", "mode"],
      "properties": {
        "repository": { "$ref": "#/$defs/repositoryView" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "mode": { "enum": ["manual", "auto", "auto_plus"] },
        "provider": { "type": ["object", "null"] },
        "active_plan": {
          "anyOf": [{ "$ref": "#/$defs/gitOperationPlan" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    }
  }
}
