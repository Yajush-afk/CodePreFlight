{
  "name": "@codepreflight/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "preflight": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && prettier --check \"src/**/*.{ts,tsx}\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
